CREATE TABLE students (
    student_id INT PRIMARY KEY AUTO_INCREMENT,
    register_no VARCHAR(20) NOT NULL UNIQUE,
    student_name VARCHAR(100) NOT NULL,
    gender VARCHAR(10),
    date_of_birth DATE,
    email VARCHAR(100) UNIQUE,
    phone VARCHAR(15),
    department VARCHAR(50),
    year_of_study INT,
    cgpa DECIMAL(3,2)
);
