SELECT
    s.register_no,
    s.student_name,
    s.department,
    p.company_name,
    p.job_role,
    p.package_lpa,
    p.placement_status
FROM students s
LEFT JOIN placements p
ON s.student_id = p.student_id;

SELECT
    s.student_name,
    s.department,
    e.activity_name,
    e.activity_type,
    e.achievement
FROM students s
JOIN extracurricular_activities e
ON s.student_id = e.student_id;

SELECT
    s.student_name,
    s.department,
    sp.sport_name,
    sp.level,
    sp.achievement
FROM students s
JOIN sports sp
ON s.student_id = sp.student_id;

SELECT
    s.student_name,
    s.department,
    p.company_name,
    p.job_role,
    p.package_lpa
FROM students s
JOIN placements p
ON s.student_id = p.student_id
WHERE p.placement_status = 'Placed';

SELECT
    s.student_name,
    s.department,
    s.cgpa
FROM students s
LEFT JOIN placements p
ON s.student_id = p.student_id
WHERE p.placement_status = 'Not Placed'
   OR p.placement_status IS NULL;
   
   SELECT
    department,
    ROUND(AVG(cgpa), 2) AS average_cgpa
FROM students
GROUP BY department;

SELECT
    department,
    COUNT(*) AS total_students
FROM students
GROUP BY department;

SELECT
    student_name,
    department,
    cgpa
FROM students
ORDER BY cgpa DESC
LIMIT 1;

SELECT
    s.student_name,
    p.company_name,
    p.job_role,
    p.package_lpa
FROM students s
JOIN placements p
ON s.student_id = p.student_id
WHERE p.package_lpa = (
    SELECT MAX(package_lpa)
    FROM placements
);

SELECT DISTINCT
    s.student_name,
    s.department,
    sp.sport_name
FROM students s
JOIN sports sp
ON s.student_id = sp.student_id;

SELECT
    s.student_name,
    e.activity_name,
    e.achievement
FROM students s
JOIN extracurricular_activities e
ON s.student_id = e.student_id
WHERE e.achievement LIKE '%Winner%'
   OR e.achievement LIKE '%First Prize%';
   
   SELECT
    s.register_no,
    s.student_name,
    s.department,
    s.year_of_study,
    s.cgpa,
    p.company_name,
    p.job_role,
    p.package_lpa,
    p.placement_status
FROM students s
LEFT JOIN placements p
ON s.student_id = p.student_id
ORDER BY s.cgpa DESC;

SELECT
    placement_status,
    COUNT(*) AS total_students
FROM placements
GROUP BY placement_status;

SELECT
    s.student_name,
    s.cgpa,
    p.company_name,
    p.package_lpa
FROM students s
LEFT JOIN placements p
ON s.student_id = p.student_id
ORDER BY s.cgpa DESC;
